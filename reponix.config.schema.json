{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReponixConfig",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "opencode",
        "claude-code",
        "copilot",
        "copilot-cli",
        "codex",
        "cursor",
        "continue",
        "windsurf",
        "gemini-cli"
      ]
    },
    "scope": {
      "type": "string",
      "enum": ["project", "global"]
    },
    "model": {
      "type": "string"
    },
    "suite": {
      "type": "string",
      "enum": ["intelligence", "modernization", "full"]
    },
    "project": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "language": {
          "type": "array",
          "items": { "type": "string" }
        },
        "framework": {
          "type": "array",
          "items": { "type": "string" }
        },
        "targetLanguage": {
          "type": "array",
          "items": { "type": "string" }
        },
        "targetFramework": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["name"]
    },
    "agents": {
      "type": "object",
      "properties": {
        "core": {
          "type": "array",
          "items": { "type": "string" }
        },
        "optional": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "skills": {
      "type": "object",
      "properties": {
        "installed": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "required": ["platform", "scope", "project"]
}
