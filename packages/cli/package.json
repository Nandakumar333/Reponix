{
  "name": "reponix",
  "version": "0.1.2",
  "description": "Scaffold production-grade multi-agent repository intelligence and modernization systems",
  "type": "module",
  "bin": {
    "reponix": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nandakumar333/Reponix.git"
  },
  "bugs": {
    "url": "https://github.com/Nandakumar333/Reponix/issues"
  },
  "homepage": "https://github.com/Nandakumar333/Reponix#readme",
  "keywords": [
    "reponix",
    "ai-agents",
    "scaffolder",
    "cli",
    "multi-agent",
    "orchestrator",
    "codebase-intelligence",
    "modernization"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node scripts/bundle.js",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "commander": "^12.1.0",
    "handlebars": "^4.7.8",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.4.2",
    "vitest": "^1.3.1"
  }
}
