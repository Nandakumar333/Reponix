### Interface: `AuthenticationService`
```typescript
interface IAuthenticationService {
  authenticate(cmd: AuthenticateCommand): Promise<AuthResult>;
  verifyMfa(cmd: VerifyMfaCommand): Promise<TokenResult>;
  sendMfaChallenge(userId: string): Promise<ChallengeResult>;
